{
  "name": "Order",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          }
        }
      }
    },
    "total": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "preparing",
        "ready",
        "completed"
      ],
      "default": "pending"
    },
    "pickup_note": {
      "type": "string"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "momo",
        "cash",
        "ggsh_ussd"
      ],
      "default": "momo"
    },
    "client_phone": {
      "type": "string"
    }
  },
  "required": [
    "customer_name",
    "items",
    "total"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}